[Unit]
Description=YT Auto Track Worker
After=network.target

[Service]
Type=simple
User=ytscan
WorkingDirectory=/home/ytscan/yt-autoscanner
ExecStart=/home/ytscan/yt-autoscanner/scripts/auto_track.sh
Restart=always
RestartSec=5

# log systemd → journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yt-auto-track

[Install]
WantedBy=multi-user.target
