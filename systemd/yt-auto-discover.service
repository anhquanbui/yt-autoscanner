[Unit]
Description=YT Auto Discover Worker
After=network.target

[Service]
Type=simple
User=ytscan
WorkingDirectory=/home/ytscan/yt-autoscanner
ExecStart=/home/ytscan/yt-autoscanner/scripts/auto_discover.sh
Restart=always
RestartSec=5

# log systemd → journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yt-auto-discover

[Install]
WantedBy=multi-user.target
