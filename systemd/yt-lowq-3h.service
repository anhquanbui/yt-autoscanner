[Unit]
Description=YT Auto lowq-3h Worker
After=network.target

[Service]
Type=simple
User=ytscan
WorkingDirectory=/home/ytscan/yt-autoscanner
ExecStart=/home/ytscan/yt-autoscanner/scripts/auto_lowq_3h.sh
Restart=always
RestartSec=5

# log systemd → journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yt-lowq-3h

[Install]
WantedBy=multi-user.target
