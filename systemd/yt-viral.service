[Unit]
Description=YT Auto Viral Pipeline (6h/12h/24h + finalize)
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=ytscan
WorkingDirectory=/home/ytscan/yt-autoscanner

# Start viral pipeline loop
ExecStart=/bin/bash /home/ytscan/yt-autoscanner/scripts/auto_viral.sh

# Keep service running
Restart=always
RestartSec=10

# Runtime env
Environment=PYTHONUNBUFFERED=1
# Environment=AUTO_VIRAL_INTERVAL_SECONDS=900  # 15 min

[Install]
WantedBy=multi-user.target
